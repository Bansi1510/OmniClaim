# PostgreSQL with pgvector extension
# For Local Docker: postgresql://postgres:postgrespassword@localhost:5432/omniclaim?schema=public
# For Cloud Neon DB: postgresql://<user>:<password>@<neon-host>/omniclaim?sslmode=require
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/omniclaim?schema=public"
