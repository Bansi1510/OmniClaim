{
  "expo": {
    "name": "OmniClaim",
    "slug": "omniclaim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#020617"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OmniClaim to take accident evidence photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow OmniClaim to verify accident site GPS coordinates."
        }
      ]
    ]
  }
}
