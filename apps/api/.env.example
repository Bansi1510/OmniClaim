# ==============================================================================
# OmniClaim NestJS API Backend Configuration Template
# Copy this file to apps/api/.env
# ==============================================================================

PORT=4000
NODE_ENV=development

# Database Connection (Neon PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/omniclaim?schema=public"

# Redis Cache (Dynamic RBAC permissions cache & Adjuster presence leases)
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Microservice Integration & Webhook Security
AI_SERVICE_URL="http://localhost:8000"
AI_WEBHOOK_SECRET="omniclaim_production_hmac_secret_key_2026"

# JWT Authentication
JWT_SECRET="omniclaim_enterprise_jwt_super_secret_key_2026"

# S3 / Cloudflare R2 / LocalStack Object Storage for Claim Evidence
S3_ENDPOINT="http://localhost:4566"
S3_BUCKET_NAME="omniclaim-evidences"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
AWS_REGION="us-east-1"
