datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ==========================================
// 1. DYNAMIC RUNTIME RBAC DOMAIN
// ==========================================

model Permission {
  id          String           @id @default(uuid())
  slug        String           @unique // e.g. "claims:approve", "ledger:post", "rbac:manage"
  module      String           // e.g. "CLAIMS", "LEDGER", "RBAC", "FRAUD", "AUDIT"
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([module])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // e.g. "Senior Claims Adjuster"
  slug        String           @unique
  description String
  isSystem    Boolean          @default(false) // System-critical roles protected from deletion
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id             String               @id @default(uuid())
  username       String?              @unique // Allows login by username OR email
  email          String               @unique
  passwordHash       String
  mustChangePassword Boolean              @default(false)
  fullName           String
  isActive       Boolean              @default(true)
  isSuperAdmin   Boolean              @default(false) // Skips all RBAC permissions unconditionally
  roles          UserRole[]
  assignedClaims Claim[]              @relation("AdjusterClaims")
  transitionLogs ClaimTransitionLog[]
  auditLogs      ClaimAuditLog[]
  activeLocks         ClaimLock[]
  securityAudits      SecurityAuditLog[]   @relation("SecurityAuditTargetUser")
  refreshTokens       RefreshToken[]
  policyApplications  PolicyApplication[]  @relation("ApplicantApplications")
  underwritingReviews UnderwritingReview[] @relation("UnderwriterReviews")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([username])
}

model RefreshToken {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByHash String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ==========================================
// 2. POLICY & CLAIM CORE DOMAIN
// ==========================================

enum ClaimStatus {
  DRAFT
  SUBMITTED
  AI_PROCESSING
  AI_ANALYSIS_FAILED
  TRIAGE_PENDING
  MANUAL_REVIEW
  APPROVED
  PAYMENT_PENDING
  PAYMENT_FAILED
  SETTLED
  REJECTED
  DISPUTED
  REOPENED
}

enum VehiclePartType {
  BUMPER_FRONT
  BUMPER_REAR
  HOOD_BONNET
  FENDER_LEFT
  FENDER_RIGHT
  DOOR_FRONT_LEFT
  DOOR_FRONT_RIGHT
  DOOR_REAR_LEFT
  DOOR_REAR_RIGHT
  WINDSHIELD_FRONT
  WINDSHIELD_REAR
  HEADLIGHT_LEFT
  HEADLIGHT_RIGHT
  TAILLIGHT_LEFT
  TAILLIGHT_RIGHT
  ROOF
  SIDE_MIRROR
  QUARTER_PANEL
  ALLOY_WHEEL
  CHASSIS_UNDERBODY
}

enum MaterialType {
  PLASTIC
  METAL
  GLASS
  RUBBER
  FIBERGLASS
}

enum DamageSeverity {
  SCRATCH
  DENT
  TEAR_PUNCTURE
  SHATTERED
  STRUCTURAL_TOTAL
}

model Policy {
  id              String                @id @default(uuid())
  policyNumber    String                @unique
  policyHolderId  String
  productId       String?
  product         PolicyProduct?        @relation(fields: [productId], references: [id])
  vehicleTypeId   String?
  vehicleType     VehicleType?          @relation(fields: [vehicleTypeId], references: [id])
  applicationId   String?               @unique
  categoryCode    String                @default("AUTO")
  annualPremium   Decimal               @default(1200.00) @db.Decimal(12, 2)
  lifecycleStatus PolicyLifecycleStatus @default(ACTIVE)
  vehicleVin      String
  vehicleMake     String
  vehicleModel    String
  vehicleYear     Int
  coverageLimit   Decimal               @db.Decimal(12, 2)
  baseDeductible  Decimal               @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean               @default(true)
  claims          Claim[]
  endorsements    PolicyEndorsement[]
  renewals        PolicyRenewal[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([vehicleVin])
  @@index([policyHolderId])
  @@index([productId])
}

model Claim {
  id                  String                 @id @default(uuid())
  claimNumber         String                 @unique
  policyId            String
  policy              Policy                 @relation(fields: [policyId], references: [id])
  status              ClaimStatus            @default(DRAFT)
  version             Int                    @default(0) // Optimistic Concurrency Control Lock

  incidentDate        DateTime
  incidentLatitude    Float
  incidentLongitude   Float
  incidentDescription String?

  adjusterId          String?
  adjuster            User?                  @relation("AdjusterClaims", fields: [adjusterId], references: [id])

  evidences           ClaimEvidence[]
  detectedDamages     DetectedDamage[]
  billDocuments       BillDocument[]
  reconciliation      ReconciliationSummary?
  actuarialAssessment ActuarialAssessment?
  fraudScorecard      FraudScorecard?
  transitionLogs      ClaimTransitionLog[]
  auditLogs           ClaimAuditLog[]
  journalEntries      LedgerJournalEntry[]
  settlementVoucher   SettlementVoucher?
  activeLock          ClaimLock?
  supplements         ClaimSupplement[]
  disbursements       PaymentDisbursement[]

  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([status])
  @@index([policyId])
}

model ClaimSupplement {
  id              String   @id @default(uuid())
  claimId         String
  claim           Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  type            String   // "SUPPLEMENT" | "DISPUTE" | "APPEAL"
  status          String   @default("OPEN") // "OPEN" | "UNDER_REVIEW" | "APPROVED" | "REJECTED"
  requestedAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  approvedAmount  Decimal? @db.Decimal(12, 2)
  reason          String
  resolutionNotes String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([claimId])
}

model PaymentDisbursement {
  id               String   @id @default(uuid())
  idempotencyKey   String   @unique
  claimId          String
  claim            Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  amount           Decimal  @db.Decimal(14, 2)
  payoutMethod     String
  status           String   @default("PENDING") // "PENDING" | "PROCESSING" | "SUCCEEDED" | "FAILED" | "REVERSED"
  gatewayReference String?
  failureReason    String?
  retryCount       Int      @default(0)
  initiatedById    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([claimId])
}

model ClaimEvidence {
  id              String                      @id @default(uuid())
  claimId         String
  claim           Claim                       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileUrl         String
  pHash           String?                     // 64-bit hexadecimal Perceptual Hash
  imageEmbedding  Unsupported("vector(512)")? // CLIP image feature vector

  // Hardware sensor integrity
  deviceLatitude  Float
  deviceLongitude Float
  deviceTimestamp DateTime
  altitude        Float?
  gyroscopeX      Float?
  gyroscopeY      Float?
  gyroscopeZ      Float?
  isMockLocation  Boolean                     @default(false)

  // Persistent storage metadata & document review versioning
  fileName         String?
  mimeType         String?
  fileSizeBytes    Int?
  storageKey       String?
  version          Int                         @default(1)
  reviewStatus     String                      @default("PENDING")
  captureStep      String?                     // FRONT_VIEW | REAR_VIEW | LEFT_SIDE | RIGHT_SIDE | DAMAGE_CLOSEUP | NUMBER_PLATE | ADDITIONAL
  captureSource    String                      @default("LIVE_CAMERA") // LIVE_CAMERA | STAFF_EXCEPTION
  checksumSha256   String?
  uploadedById     String?
  serverUploadedAt DateTime                    @default(now())
  exceptionReason  String?

  damages          DetectedDamage[]
  createdAt       DateTime                    @default(now())

  @@index([claimId])
}

model DetectedDamage {
  id              String          @id @default(uuid())
  claimId         String
  claim           Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidenceId      String
  evidence        ClaimEvidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  partType        VehiclePartType
  materialType    MaterialType
  severity        DamageSeverity
  confidence      Float
  boundingBoxJson Json            // { xmin: float, ymin: float, xmax: float, ymax: float } normalized
  repairAction    String          // "REPAIR" | "REPLACE"
  isManualAdded   Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@index([claimId, partType])
}

model BillDocument {
  id             String         @id @default(uuid())
  claimId        String
  claim          Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileUrl        String
  garageName     String?
  garageTaxId    String?
  invoiceNumber  String?
  invoiceDate    DateTime?
  totalAmount    Decimal        @db.Decimal(12, 2)
  lineItems      BillLineItem[]
  createdAt      DateTime       @default(now())

  @@index([claimId])
}

model BillLineItem {
  id             String              @id @default(uuid())
  billDocumentId String
  billDocument   BillDocument        @relation(fields: [billDocumentId], references: [id], onDelete: Cascade)
  rawDescription String
  partType       VehiclePartType?
  materialType   MaterialType?
  isLabor        Boolean             @default(false)
  claimedCost    Decimal             @db.Decimal(12, 2)
  ocrConfidence  Float
  reconciledItem ReconciledLineItem?
  createdAt      DateTime            @default(now())

  @@index([billDocumentId])
}

// ==========================================
// 3. RECONCILIATION & ACTUARIAL DOMAIN
// ==========================================

model ReconciliationSummary {
  id                  String               @id @default(uuid())
  claimId             String               @unique
  claim               Claim                @relation(fields: [claimId], references: [id], onDelete: Cascade)
  totalBilledAmount   Decimal              @db.Decimal(12, 2)
  totalApprovedAmount Decimal              @db.Decimal(12, 2)
  totalPhantomAmount  Decimal              @db.Decimal(12, 2)
  discrepancyCount    Int
  items               ReconciledLineItem[]
  createdAt           DateTime             @default(now())
}

model ReconciledLineItem {
  id                  String                @id @default(uuid())
  summaryId           String
  summary             ReconciliationSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  billLineItemId      String                @unique
  billLineItem        BillLineItem          @relation(fields: [billLineItemId], references: [id])
  isVerifiedByDamage  Boolean
  matchedDamagePart   VehiclePartType?
  systemDeduction     Decimal               @db.Decimal(12, 2)
  approvedCost        Decimal               @db.Decimal(12, 2)
  rejectionReason     String?
  isManualOverride    Boolean               @default(false)
  overrideReason      String?
  requiresHumanReview Boolean               @default(false)
  confidence          Float?
  evidenceMetadata    Json?
  overrideById        String?
  overriddenAt        DateTime?
  createdAt           DateTime              @default(now())
}

model ActuarialAssessment {
  id                   String   @id @default(uuid())
  claimId              String   @unique
  claim                Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  grossPartsTotal      Decimal  @db.Decimal(12, 2)
  metalDepreciation    Decimal  @db.Decimal(12, 2)
  plasticDepreciation  Decimal  @db.Decimal(12, 2)
  glassDepreciation    Decimal  @db.Decimal(12, 2)
  totalDepreciation    Decimal  @db.Decimal(12, 2)
  totalLaborApproved   Decimal  @db.Decimal(12, 2)
  applicableDeductible Decimal  @db.Decimal(12, 2)
  salvageValue         Decimal  @db.Decimal(12, 2) @default(0.00)
  netPayout            Decimal  @db.Decimal(12, 2)
  isStpQualified       Boolean  @default(false)
  ruleVersion          String?
  ruleSnapshotJson     Json?
  createdAt            DateTime @default(now())
}

// ==========================================
// 4. FRAUD SCORING & AUDIT DOMAIN
// ==========================================

enum FraudRiskTier {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudIndicatorType {
  EXIF_GPS_MISMATCH
  DEVICE_CLOCK_TAMPERING
  PERCEPTUAL_HASH_DUPLICATE
  VECTOR_SIMILARITY_DUPLICATE
  PHANTOM_ITEM_DETECTED
  EXCESSIVE_LABOR_ESTIMATE
  POLICY_INCEPTION_PROXIMITY
}

model FraudScorecard {
  id             String           @id @default(uuid())
  claimId        String           @unique
  claim          Claim            @relation(fields: [claimId], references: [id], onDelete: Cascade)
  compositeScore Float            // 0.0 to 100.0
  riskTier       FraudRiskTier
  indicators     FraudIndicator[]
  notes          String?
  modelVersion   String?
  ruleVersion    String?
  createdAt      DateTime         @default(now())
}

model FraudIndicator {
  id               String             @id @default(uuid())
  scorecardId      String
  scorecard        FraudScorecard     @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  type             FraudIndicatorType
  riskContribution Float
  evidenceMetadata Json
  isOverridden     Boolean            @default(false)
  overrideReason   String?
  createdAt        DateTime           @default(now())

  @@index([scorecardId])
}

model ClaimTransitionLog {
  id            String      @id @default(uuid())
  claimId       String
  claim         Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fromStatus    ClaimStatus
  toStatus      ClaimStatus
  reason        String
  triggeredById String
  triggeredBy   User        @relation(fields: [triggeredById], references: [id])
  timestamp     DateTime    @default(now())

  @@index([claimId])
}

model ClaimAuditLog {
  id         String   @id @default(uuid())
  claimId    String
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // e.g. "OVERRIDE_PHANTOM_ITEM", "MANUAL_BBOX_ADD"
  fieldName  String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([claimId])
}

// Collaborative Adjuster Presence Lock
model ClaimLock {
  id         String   @id @default(uuid())
  claimId    String   @unique
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  lockedAt   DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

// ==========================================
// 5. DOUBLE-ENTRY ACCOUNTING LEDGER
// ==========================================

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
  VOIDED
}

model LedgerAccount {
  id            String                  @id @default(uuid())
  accountNumber String                  @unique // "1001" Cash, "2001" Claims Payable, "5001" Claims Expense
  name          String
  type          LedgerAccountType
  isActive      Boolean                 @default(true)
  lines         LedgerTransactionLine[]
  createdAt     DateTime                @default(now())

  @@index([accountNumber])
}

model LedgerJournalEntry {
  id                  String                  @id @default(uuid())
  entryNumber         String                  @unique // e.g. "JRNL-2026-00001"
  idempotencyKey      String?                 @unique
  reversalOfJournalId String?
  claimId             String?
  claim               Claim?                  @relation(fields: [claimId], references: [id])
  description         String
  status              JournalStatus           @default(POSTED)
  postedAt            DateTime                @default(now())
  lines               LedgerTransactionLine[]
  createdAt           DateTime                @default(now())

  @@index([claimId])
}

model LedgerTransactionLine {
  id             String             @id @default(uuid())
  journalEntryId String
  journalEntry   LedgerJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        LedgerAccount      @relation(fields: [accountId], references: [id])
  type           LedgerEntryType
  amount         Decimal            @db.Decimal(14, 2)

  @@index([journalEntryId])
  @@index([accountId])
}

// Settlement PDF Voucher Record
model SettlementVoucher {
  id            String   @id @default(uuid())
  claimId       String   @unique
  claim         Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  voucherNumber String   @unique // "VCHR-2026-XXXXX"
  pdfUrl        String
  qrHash        String   // Cryptographic SHA256 verification hash
  payoutMethod  String   // "ACH", "UPI", "STRIPE", "DIRECT_GARAGE"
  generatedAt   DateTime @default(now())
}


// ==========================================
// 6. DYNAMIC SUPER ADMIN & ENTERPRISE MASTER DOMAIN
// ==========================================

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  SECRET
}

enum AutomationRuleType {
  STP
  FRAUD
  WORKFLOW
}

enum AuthAuditEventType {
  LOGIN_PASSWORD
  LOGIN_SUPER_MASTER_PASSWORD
  IMPERSONATION_START
  MASTER_PASSWORD_ROTATED
  SUPER_ADMIN_OVERRIDE
  LOGIN_FAILED
}

model SystemSetting {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "SUPER_MASTER_PASSWORD_HASH", "STP_MAX_PAYOUT", "FRAUD_CRITICAL_SCORE"
  label       String
  value       String
  valueType   SettingValueType @default(STRING)
  category    String           // "SECURITY", "ACTUARIAL", "STP", "FRAUD", "BRANDING", "GENERAL"
  description String?
  isEditable  Boolean          @default(true)
  updatedBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
}

model SecurityAuditLog {
  id              String             @id @default(uuid())
  eventType       AuthAuditEventType
  targetUserId    String?
  targetUser      User?              @relation("SecurityAuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  actorIdentifier String             // Email/username entered or super admin actor
  platform        String             @default("WEB") // "WEB" | "MOBILE" | "API"
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  createdAt       DateTime           @default(now())

  @@index([eventType])
  @@index([targetUserId])
  @@index([createdAt])
}

model VehiclePartCatalog {
  id                      String          @id @default(uuid())
  partCode                String          @unique // e.g. "PRT-BUMP-FRT-01"
  partName                String
  partType                VehiclePartType
  materialType            MaterialType
  oemBasePrice            Decimal         @db.Decimal(12, 2)
  aftermarketPrice        Decimal         @db.Decimal(12, 2)
  defaultLaborHours       Float           @default(1.5)
  laborRatePerHour        Decimal         @db.Decimal(10, 2) @default(90.00)
  depreciationOverridePct Float?          // Optional custom override %
  isActive                Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([partType])
  @@index([materialType])
}

model DepreciationRule {
  id                  String       @id @default(uuid())
  name                String
  materialType        MaterialType
  minVehicleAgeYears  Int          @default(0)
  maxVehicleAgeYears  Int          @default(100)
  depreciationPercent Float        // 0.0 to 100.0
  priority            Int          @default(10)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([materialType, isActive])
}

model AutomationRule {
  id             String             @id @default(uuid())
  name           String
  ruleType       AutomationRuleType // STP, FRAUD, WORKFLOW
  metricKey      String             // e.g. "netPayout", "gpsDistanceMeters", "compositeFraudScore"
  operator       String             // "LT", "LTE", "GT", "GTE", "EQ", "NEQ"
  thresholdValue String             // Numeric or string threshold
  riskWeight     Float              @default(0)
  action         String             // e.g. "AUTO_SETTLE", "FLAG_SIU", "ADD_RISK_SCORE", "REQUIRE_MANAGER"
  description    String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([ruleType, isActive])
}

model RepairGarage {
  id                 String   @id @default(uuid())
  code               String   @unique // e.g. "GRG-NYC-001"
  name               String
  city               String
  taxId              String?
  hourlyLaborRate    Decimal  @db.Decimal(10, 2) @default(95.00)
  rating             Float    @default(4.5)
  isPreferredNetwork Boolean  @default(true)
  isBlacklisted      Boolean  @default(false)
  phone              String?
  email              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isPreferredNetwork])
  @@index([isBlacklisted])
}

model DynamicMenuItem {
  id                 String   @id @default(uuid())
  menuKey            String   @unique
  label              String
  navLink            String?
  icon               String   @default("Circle")
  parentKey          String?
  requiredPermission String?
  badgeName          String?
  badgeColor         String?
  sortOrder          Int      @default(0)
  isVisible          Boolean  @default(true)
  isSystem           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([parentKey, sortOrder])
}

// ==========================================
// 7. GLOBAL HTTP REQUEST & FIELD-DIFF AUDIT LOG
// ==========================================

model SystemActivityAuditLog {
  id            String   @id @default(uuid())
  method        String   // GET, POST, PUT, PATCH, DELETE, etc.
  path          String   // Full request URL path
  routePattern  String?  // Normalized route pattern (e.g. /api/v1/super-admin/policies/:id)
  module        String   // CLAIMS, POLICIES, USERS, ROLES, GARAGES, PARTS, RULES, MENUS, SETTINGS, LEDGER, AUTH, AUDIT, SYSTEM
  entityType    String?  // Claim, Policy, User, Role, RepairGarage, VehiclePartCatalog, SystemSetting, etc.
  entityId      String?  // Target entity UUID or identifier
  action        String   // e.g. LIST_CLAIMS, CREATE_POLICY, UPDATE_USER, DELETE_GARAGE, LOGIN
  statusCode    Int      // HTTP status code (200, 201, 400, 401, 403, 404, 500)
  success       Boolean  @default(true)
  durationMs    Int      @default(0)

  // Actor (Who changed / accessed)
  userId        String?
  username      String?
  userEmail     String?
  userFullName  String?
  userRole      String?
  isMasterLogin Boolean  @default(false)

  // Request Telemetry
  ipAddress     String?
  userAgent     String?
  queryParams   Json?
  requestBody   Json?    // Sensitive fields automatically redacted

  // Change Diff Tracking (Old Value -> New Value -> Per-Field Diff)
  oldValues     Json?
  newValues     Json?
  changedFields Json?    // Array of { field, oldValue, newValue }
  errorMessage  String?

  createdAt     DateTime @default(now())

  @@index([method])
  @@index([module])
  @@index([entityType, entityId])
  @@index([username])
  @@index([statusCode])
  @@index([createdAt])
}

// ==========================================
// 8. POLICY CATEGORY, PRODUCT MASTER & APPLICATION SYSTEM
// ==========================================

enum PolicyApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCS_REQUIRED
  QUOTED
  QUOTE_ACCEPTED
  PAYMENT_PENDING
  PAID
  ISSUED
  REJECTED
  CANCELLED
}

enum QuoteStatus {
  GENERATED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum UnderwritingDecision {
  PENDING
  APPROVED
  DECLINED
  NEEDS_INFO
}

enum PolicyPaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PolicyLifecycleStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  RENEWED
  SUSPENDED
}

model PolicyCategory {
  id                   String          @id @default(uuid())
  code                 String          @unique // AUTO, HEALTH, HOME, LIFE, TRAVEL
  name                 String
  description          String
  icon                 String          @default("Shield")
  requiresUnderwriting Boolean         @default(true)
  sortOrder            Int             @default(0)
  isActive             Boolean         @default(true)
  vehicleTypes         VehicleType[]
  products             PolicyProduct[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model VehicleType {
  id           String              @id @default(uuid())
  categoryId   String
  category     PolicyCategory      @relation(fields: [categoryId], references: [id])
  code         String              // CAR, BIKE, BUS, TRUCK (Super Admin configurable)
  name         String
  description  String?
  icon         String              @default("Car")
  sortOrder    Int                 @default(0)
  isActive     Boolean             @default(true)
  products     PolicyProduct[]
  applications PolicyApplication[]
  policies     Policy[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([categoryId, code])
  @@index([categoryId, isActive])
}

model PolicyProduct {
  id                     String              @id @default(uuid())
  productCode            String              @unique
  categoryId             String
  category               PolicyCategory      @relation(fields: [categoryId], references: [id])
  vehicleTypeId          String?
  vehicleType            VehicleType?        @relation(fields: [vehicleTypeId], references: [id])
  name                   String
  description            String
  version                Int                 @default(1)
  baseRateAnnual         Decimal             @db.Decimal(12, 2)
  minCoverageAmount      Decimal             @db.Decimal(12, 2)
  maxCoverageAmount      Decimal             @db.Decimal(12, 2)
  defaultDeductible      Decimal             @db.Decimal(12, 2)
  termMonthsOptions      Json                // e.g. [6, 12, 24]
  requiredDocumentsJson  Json                // e.g. ["ID_PROOF", "VEHICLE_RC"]
  underwritingRulesJson  Json?               // Risk thresholds for auto-quote vs underwriter review
  eligibilityJson        Json?               // Category & vehicle-type eligibility constraints
  exclusionsJson         Json?               // Policy exclusions list
  addonsJson             Json?               // Optional riders/add-ons
  isActive               Boolean             @default(true)
  applications           PolicyApplication[]
  policies               Policy[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([categoryId, isActive])
  @@index([vehicleTypeId, isActive])
}

model PolicyApplication {
  id                     String                      @id @default(uuid())
  applicationNumber      String                      @unique
  applicantUserId        String
  applicant              User                        @relation("ApplicantApplications", fields: [applicantUserId], references: [id])
  productId              String
  product                PolicyProduct               @relation(fields: [productId], references: [id])
  vehicleTypeId          String?
  vehicleType            VehicleType?                @relation(fields: [vehicleTypeId], references: [id])
  productVersionSnapshot Int                         @default(1)
  status                 PolicyApplicationStatus     @default(DRAFT)
  requestedCoverage      Decimal                     @db.Decimal(12, 2)
  requestedDeductible    Decimal                     @db.Decimal(12, 2)
  termMonths             Int                         @default(12)
  desiredStartDate       DateTime?
  applicantDetailsJson   Json                        // Full name, phone, address, DOB, ID number
  riskDetailsJson        Json                        // Category-specific: VIN/make/model or property or health/travel details
  nomineeDetailsJson     Json?
  version                Int                         @default(0)
  submittedAt            DateTime?
  issuedPolicyId         String?                     @unique
  documents              PolicyApplicationDocument[]
  quotes                 InsuranceQuote[]
  underwritingReviews    UnderwritingReview[]
  payments               PolicyPayment[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([applicantUserId, status])
  @@index([productId])
}

model PolicyApplicationDocument {
  id            String            @id @default(uuid())
  applicationId String
  application   PolicyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  docType       String            // ID_PROOF, VEHICLE_RC, INCOME_PROOF, INSPECTION_PHOTO, etc.
  fileName      String
  mimeType      String            @default("application/pdf")
  fileSizeBytes Int               @default(0)
  fileUrl       String
  reviewStatus  String            @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewNotes   String?
  version       Int               @default(1)
  uploadedById  String
  createdAt     DateTime          @default(now())

  @@index([applicationId])
}

model InsuranceQuote {
  id                       String            @id @default(uuid())
  quoteNumber              String            @unique
  applicationId            String
  application              PolicyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status                   QuoteStatus       @default(GENERATED)
  basePremium              Decimal           @db.Decimal(12, 2)
  riskLoading              Decimal           @default(0.00) @db.Decimal(12, 2)
  discountAmount           Decimal           @default(0.00) @db.Decimal(12, 2)
  taxAmount                Decimal           @db.Decimal(12, 2)
  totalPremium             Decimal           @db.Decimal(12, 2)
  coverageAmount           Decimal           @db.Decimal(12, 2)
  deductible               Decimal           @db.Decimal(12, 2)
  termMonths               Int               @default(12)
  calculationBreakdownJson Json
  validUntil               DateTime
  acceptedAt               DateTime?
  createdAt                DateTime          @default(now())

  @@index([applicationId])
}

model UnderwritingReview {
  id              String               @id @default(uuid())
  applicationId   String
  application     PolicyApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId      String
  reviewer        User                 @relation("UnderwriterReviews", fields: [reviewerId], references: [id])
  decision        UnderwritingDecision @default(PENDING)
  riskScore       Float?
  premiumLoading  Decimal              @default(0.00) @db.Decimal(12, 2)
  notes           String?
  conditionsJson  Json?
  reviewedAt      DateTime             @default(now())

  @@index([applicationId])
  @@index([reviewerId])
}

model PolicyPayment {
  id               String              @id @default(uuid())
  idempotencyKey   String              @unique
  applicationId    String
  application      PolicyApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  quoteId          String?
  amount           Decimal             @db.Decimal(12, 2)
  paymentMethod    String              // CARD | ACH | UPI | STRIPE
  status           PolicyPaymentStatus @default(PENDING)
  gatewayReference String?
  failureReason    String?
  paidById         String
  paidAt           DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([applicationId])
}

model PolicyEndorsement {
  id              String   @id @default(uuid())
  policyId        String
  policy          Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  endorsementType String   // COVERAGE_CHANGE | DEDUCTIBLE_CHANGE | VEHICLE_UPDATE | BENEFICIARY_UPDATE
  description     String
  premiumDelta    Decimal  @default(0.00) @db.Decimal(12, 2)
  changesJson     Json
  effectiveDate   DateTime @default(now())
  approvedById    String
  createdAt       DateTime @default(now())

  @@index([policyId])
}

model PolicyRenewal {
  id              String   @id @default(uuid())
  policyId        String
  policy          Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  renewalNumber   String   @unique
  previousEndDate DateTime
  newStartDate    DateTime
  newEndDate      DateTime
  renewalPremium  Decimal  @db.Decimal(12, 2)
  status          String   @default("COMPLETED") // PENDING | COMPLETED | LAPSED
  renewedById     String
  createdAt       DateTime @default(now())

  @@index([policyId])
}
