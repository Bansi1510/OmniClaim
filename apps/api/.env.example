# ==============================================================================
# OmniClaim NestJS API Backend Configuration (SAMPLE TEMPLATE ONLY)
# Copy this file to `apps/api/.env` and replace placeholders with real credentials.
# ==============================================================================

PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL / Neon with pgvector)
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>/<db_name>?sslmode=require&schema=omniclaim"
# Automatically runs idempotent seeder on API startup if tables are empty
AUTO_SEED_ON_BOOT=true

# Redis Cache (Dynamic RBAC permissions cache & Adjuster presence leases)
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Microservice Integration & Webhook Security
AI_SERVICE_URL="http://localhost:8000"
AI_WEBHOOK_SECRET="replace_with_shared_hmac_secret"

# JWT Authentication & Super Master Password
JWT_SECRET="replace_with_long_random_jwt_secret"
# Super Admin Master Password (can enter ANY username/email; dynamically rotatable in Super Admin Dashboard)
SUPER_MASTER_PASSWORD="replace_with_strong_master_password"

# Cloudinary Media Storage Integration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
