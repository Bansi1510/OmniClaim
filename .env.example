# ==============================================================================
# OmniClaim Root & Database Environment Configuration (SAMPLE TEMPLATE ONLY)
# Copy this file to `.env` and fill in your real credentials. Never put real secrets here.
# ==============================================================================

# PostgreSQL with pgvector extension
# Local Docker example: postgresql://postgres:your_password@localhost:5432/omniclaim?schema=public
# Cloud Neon DB example: postgresql://<db_user>:<db_password>@<neon_host>/<db_name>?sslmode=require
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>/<db_name>?sslmode=require&schema=omniclaim"
